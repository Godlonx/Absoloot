{
  "openapi": "3.0.3",
  "info": {
    "title": "API Gestion des Aventuriers",
    "version": "1.0.0",
    "description": "API REST pour la gestion des aventuriers — création, consultation, modification et suppression.",
    "contact": {
      "name": "Guilde des Aventuriers"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Serveur local de développement"
    },
    {
      "url": "https://aventuriers.digicrafters.fr",
      "description": "Serveur de production"
    }
  ],
  "paths": {
    "/api/v1": {},
    "/api/v1/aventurers": {
      "get": {
        "tags": [
          "Adventurers"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AdventurerDto"
                  }
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "operationId": "listAdventurer",
        "summary": "Lister tous les aventuriers"
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdventurerPayload"
              }
            }
          },
          "required": true
        },
        "tags": [
          "Adventurers"
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventurerDto"
                }
              }
            },
            "description": "Créé"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "operationId": "createAdventurer",
        "summary": "Créer un aventurier"
      }
    },
    "/api/v1/aventurers/{id}": {
      "get": {
        "tags": [
          "Adventurers"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventurerDto"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "operationId": "getAdventurer",
        "summary": "Consulter un aventurier"
      },
      "put": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdventurerPayload"
              }
            }
          },
          "required": true
        },
        "tags": [
          "Adventurers"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdventurerDto"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "operationId": "updateAdventurer",
        "summary": "Modifier un aventurier"
      },
      "delete": {
        "tags": [
          "Adventurers"
        ],
        "responses": {
          "204": {
            "description": "Supprimé"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "operationId": "deleteAdventurer",
        "summary": "Supprimer un aventurier"
      },
      "parameters": [
        {
          "name": "id",
          "schema": {
            "format": "uuid",
            "type": "string"
          },
          "in": "path",
          "required": true
        }
      ]
    },
    "/api/v1/auth": {},
    "/api/v1/auth/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCredentials"
              }
            }
          },
          "required": true
        },
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SuccessfullConnexion"
          }
        },
        "operationId": "login",
        "description": "Public Access"
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterCrendentials"
              }
            }
          }
        },
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SuccessfullConnexion"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid registry data"
          }
        },
        "operationId": "register",
        "description": "Public access"
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "required": [
          "status",
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        }
      },
      "AdventurerDto": {
        "allOf": [
          {
            "required": [
              "id"
            ],
            "type": "object",
            "properties": {
              "id": {
                "format": "uuid",
                "type": "string"
              }
            }
          },
          {
            "$ref": "#/components/schemas/AdventurerPayload"
          }
        ]
      },
      "AdventurerPayload": {
        "required": [
          "name",
          "physical",
          "mental",
          "perception",
          "level",
          "advClass"
        ],
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "mental": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "perception": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "physical": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "minLength": 3,
            "type": "string"
          },
          "level": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "advClass": {
            "enum": [
              "GUERRIER",
              "MAGE",
              "RODEUR",
              "VOLEUR",
              "CLERC",
              "BARDE",
              "DRUIDE",
              "PALADIN",
              "BARBARE",
              "MOINE"
            ],
            "type": "string"
          }
        }
      },
      "UserCredentials": {
        "title": "Root Type for UserCredentials",
        "description": "",
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "example": {
          "username": "string",
          "password": "string"
        }
      },
      "LoginData": {
        "title": "Root Type for LoginData",
        "description": "",
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "example": {
          "token": "string",
          "role": "string"
        }
      },
      "RegisterCrendentials": {
        "title": "Root Type for RegisterCrendentials",
        "description": "",
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "example": {
          "username": "string",
          "password": "string"
        }
      }
    },
    "responses": {
      "ServerError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Erreur serveur"
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Ressource introuvable"
      },
      "InvalidRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Requête invalide"
      },
      "SuccessfullConnexion": {
        "content": {
          "application/json": {
            "schema": {
              "type": "string"
            }
          }
        },
        "description": ""
      }
    }
  },
  "tags": [
    {
      "name": "Adventurers",
      "description": "Opérations CRUD sur les aventuriers"
    },
    {
      "name": "Skills",
      "description": "CRUD operation on Skills"
    }
  ]
}